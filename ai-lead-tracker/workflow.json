            "followup_sent": "Yes"
          },
          "schema": []
        }
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "e947c0c8-f1db-4d8f-a297-252882c80e66",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        100,
        496
      ],
      "parameters": {
        "content": "## AI Lead Tracker\nThree ways in: webhook (needs the x-api-key header), web form, Telegram bot.\n\n**Google Sheet headers (row 1):**\nlead_id, date, name, phone, email, message, source, score, reason, suggested_reply, status, followup_sent\n\n**Before you run:** pick your sheet in the 3 Google Sheets nodes, paste your Telegram chat ID in the 2 Alert/Reminder nodes, set your own secret in Valid API Key?, and connect your credentials.\n\nTo stop a lead's follow-up, change its status in the sheet from New to Contacted.",
        "color": 4
      }
    },
    {
      "id": "22e53533-641d-4b1d-b5da-253219fd6678",
      "name": "Lead Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        240,
        500
      ],
      "parameters": {
        "authentication": "none",
        "formDescription": "Tell us what you need and we will reply very soon.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Your name",
              "fieldName": "name",
              "fieldType": "text",
              "placeholder": "Full name",
              "requiredField": true
            },
            {
              "fieldLabel": "Phone number",
              "fieldName": "phone",
              "fieldType": "text",
              "placeholder": "+251...",
              "requiredField": true
            },
            {
              "fieldLabel": "Email (optional)",
              "fieldName": "email",
              "fieldType": "email",
              "placeholder": "you@example.com"
            },
            {
              "fieldLabel": "How can we help you?",
              "fieldName": "message",
              "fieldType": "textarea",
              "placeholder": "Write your question or what you want to buy",
              "requiredField": true
            },
            {
              "defaultValue": "Lead Form",
              "fieldName": "source",
              "fieldType": "hiddenField"
            }
          ]
        },
        "formTitle": "Contact Us",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Send",
          "path": "lead-form",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Thank you! We received your message and will contact you very soon.",
              "respondWith": "text"
            }
          }
        },
        "responseMode": "onReceived"
      }
    },
    {

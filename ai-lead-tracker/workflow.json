          "combinator": "and"
        }
      }
    },
    {
      "id": "2d21f43f-e806-475b-92d6-0f5d9a58c59a",
      "name": "Send Follow-Up Reminder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        2940,
        200
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=⏰ FOLLOW-UP NEEDED (2 days, no contact yet)\nName: {{ $json.name }}\nPhone: {{ $json.phone }}\n\nSuggested follow-up:\n{{ $json.suggested_reply }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "801f8f18-1e3a-47ac-9bf4-94160730958f",
      "name": "Mark Follow-Up Sent",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        3240,
        200
      ],
      "parameters": {

      "name": "Alert Owner",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1740,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "={{ $(\"Build Lead Row\").item.json.score === \"Hot\" ? \"🔥 HOT LEAD\" : \"New lead\" }}\nName: {{ $(\"Build Lead Row\").item.json.name }} ({{ $(\"Build Lead Row\").item.json.score }})\nPhone: {{ $(\"Build Lead Row\").item.json.phone }}\nSource: {{ $(\"Build Lead Row\").item.json.source }}\nMessage: {{ $(\"Build Lead Row\").item.json.message }}\nWhy: {{ $(\"Build Lead Row\").item.json.reason }}\n\nSuggested reply:\n{{ $(\"Build Lead Row\").item.json.suggested_reply }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "id": "c2f8b93a-2143-4a44-a437-9fde0dca30b4",

{
  "name": "AI Lead Tracker with Follow-Up",
  "nodes": [
    {
      "id": "fe6e30bb-b035-4245-9937-452924a793e6",
      "name": "New Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        240,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "new-lead",
        "authentication": "none",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "ace44043-5af7-48b3-9d8d-c5b58c734400",
      "name": "Valid API Key?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        390,
        200
      ],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-api-key'] ?? '' }}",
              "operator": {
                "operation": "equals",
                "type": "string"
              },
              "rightValue": "YOUR_SECRET_KEY"
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          }
        }
      }
    },
    {
      "id": "810d8cd7-d169-4344-8b09-d45bbf94cae7",
      "name": "Clean Lead Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        540,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "205b1e63-5089-43af-9de6-42059726a139",
              "name": "lead_id",
              "value": "={{ $now.toMillis() }}",
              "type": "string"
            },
            {
              "id": "0f45fdfd-f815-4500-93e8-e8559de1e0ed",
              "name": "date",
              "value": "={{ $now.toFormat(\"yyyy-MM-dd HH:mm\") }}",
              "type": "string"
            },
            {
              "id": "4223658f-920f-43fc-b294-d7d5ac5f0424",
              "name": "name",
              "value": "={{ $json.body?.name ?? $json.name ?? \"Unknown\" }}",
              "type": "string"
            },
            {
              "id": "9eae3ebd-20c0-495d-b3aa-acae271cc05e",
              "name": "phone",
              "value": "={{ $json.body?.phone ?? $json.phone ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "1964019d-8789-4388-97c0-7bd42a1bc8e5",
              "name": "email",
              "value": "={{ $json.body?.email ?? $json.email ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "75e0298d-9d55-4af6-bb2d-12a3b59467dd",
              "name": "message",
              "value": "={{ $json.body?.message ?? $json.message ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "b3cf1898-d42e-4eae-b804-f73a4d0a6112",
              "name": "source",
              "value": "={{ $json.body?.source ?? $json.source ?? \"Unknown\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "43340bbf-3392-4b4e-acbd-dcabbef332c6",
      "name": "AI Score Lead",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        840,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Lead name: {{ $json.name }}\nSource: {{ $json.source }}\nMessage: {{ $json.message }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You are a sales assistant for a small business. Read the lead message and score it. Hot = ready to buy, asking for price, or wants to book. Warm = interested but has questions. Cold = just browsing or unclear.\n\nAlso write a friendly suggested_reply of exactly 2 short sentences, in the same language as the lead message.\n\nBUSINESS INFO (edit these lines for each client):\nBusiness name: Ashu Shop\nServices and prices: Haircut 300 birr\nOpening hours: Monday to Friday, 8:00 to 19:00\nLocation: Assosa\n\nRULES FOR THE REPLY:\n- Use only the business info above. Never invent prices, hours, or facts.\n- If a field says NOT SET, do not mention it. Instead invite the lead to share a good time to talk or call.\n- Never write placeholders like [Price] or [Name].\n- Reply only in the required JSON format."
            }
          ]
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "3b1bcf31-5ae3-4ab5-a8ca-68b37a471f39",
      "name": "Gemini Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        540,
        520
      ],
      "parameters": {
        "modelName": "models/gemini-3-flash-preview",
        "options": {
          "temperature": 0.1
        }
      },
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "id": "e21e372c-834a-4c28-8a1e-6b80188c00e6",
      "name": "Lead Score Format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        700,
        520
      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{ \"score\": \"Hot\", \"reason\": \"Asks about price and wants to start this week\", \"suggested_reply\": \"Hi Sara, thanks for your interest! Our monthly package is available and we can start this week. When is a good time to talk?\" }"
      }
    },
    {
      "id": "2a4bc925-9eed-4a23-b74d-d1d61b556b3c",
      "name": "Build Lead Row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1140,
        300
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "adb896c6-7678-4130-a0ec-98038b79e3fc",
              "name": "lead_id",
              "value": "={{ $('Clean Lead Data').item.json.lead_id }}",
              "type": "string"
            },
            {
              "id": "208631a7-2839-4f6e-8532-9a7ddf36d467",
              "name": "date",
              "value": "={{ $('Clean Lead Data').item.json.date }}",
              "type": "string"
            },
            {
              "id": "b9e1f124-5d04-4127-805b-7ac21e8e2a4f",
              "name": "name",
              "value": "={{ $('Clean Lead Data').item.json.name }}",
              "type": "string"
            },
            {
              "id": "91b00662-2269-4a1c-b8f7-63c286b8527b",
              "name": "phone",
              "value": "={{ $('Clean Lead Data').item.json.phone }}",
              "type": "string"
            },
            {
              "id": "98a07343-a676-4f24-8a1c-20cfc0a052a7",
              "name": "email",
              "value": "={{ $('Clean Lead Data').item.json.email }}",
              "type": "string"
            },
            {
              "id": "3f7e1836-1b30-4b5b-9afc-bafd053deb0b",
              "name": "message",
              "value": "={{ $('Clean Lead Data').item.json.message }}",
              "type": "string"
            },
            {
              "id": "26207baa-50c5-42d2-8888-a8f99b492d04",
              "name": "source",
              "value": "={{ $('Clean Lead Data').item.json.source }}",
              "type": "string"
            },
            {
              "id": "9fb0907b-83ef-4c1f-a197-b0f1ace4c517",
              "name": "score",
              "value": "={{ $json.output?.score ?? \"Unscored\" }}",
              "type": "string"
            },
            {
              "id": "2592f0c5-ecab-4e58-9ab3-f62305d9c77c",
              "name": "reason",
              "value": "={{ $json.output?.reason ?? \"AI scoring failed - check manually\" }}",
              "type": "string"
            },
            {
              "id": "f12eb2d0-8197-4921-809f-f829ee0836be",
              "name": "suggested_reply",
              "value": "={{ $json.output?.suggested_reply ?? \"\" }}",
              "type": "string"
            },
            {
              "id": "ab58a41d-0645-43ec-ba60-423b30dcd777",
              "name": "status",
              "value": "New",
              "type": "string"
            },
            {
              "id": "a27e15b4-7eca-47e9-8f7e-68d8acf92000",
              "name": "followup_sent",
              "value": "No",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "95809d8a-b660-4842-8af8-dc4305bbb625",
      "name": "Save to Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "resource": "sheet",
